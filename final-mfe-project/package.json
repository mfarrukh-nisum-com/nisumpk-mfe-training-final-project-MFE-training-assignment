{
  "name": "final-mfe-project",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Micro Frontend platform: Gateway + Product MFE + Cart MFE + Backend API, composed via Webpack Module Federation inside an Nx-style monorepo.",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "nx run-many --target=serve --projects=api,gateway,mfe-product,mfe-cart,mfe-orders --parallel=5",
    "build": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "tsc -b tsconfig.base.json --noEmit",
    "test": "nx run-many --target=test --all",
    "graph": "nx graph",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nx": "^19.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
