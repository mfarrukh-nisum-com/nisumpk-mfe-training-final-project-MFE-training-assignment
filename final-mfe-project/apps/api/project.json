{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["type:app", "scope:api"],
  "implicitDependencies": ["shared-types"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run start", "cwd": "apps/api" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "apps/api" },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npx jest --selectProjects api", "cwd": "." }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint 'apps/api/src/**/*.ts'", "cwd": "." }
    }
  }
}
